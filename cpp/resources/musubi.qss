* { color: #E2E8F0; font-size: 10pt; }
QMainWindow { background: #0B1220; }
QGroupBox { background: #111A2E; border: 1px solid #1E293B; border-radius: 10px; margin-top: 18px; padding: 20px 16px 16px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; top: 4px; color: #94A3B8; font-size: 9pt; }
QLabel { background: transparent; }
QLabel[secondary="true"] { color: #94A3B8; }
QLabel#mediaBadge { background: #1E293B; border: 1px solid #334155; border-radius: 6px; padding: 4px 7px; color: #CBD5E1; }
QLabel#chapterBadge { color: #F59E0B; font-size: 9pt; }
QLabel#chapterBadge[tone="success"] { color: #22C55E; }
QLabel#chapterBadge[tone="warning"] { color: #F59E0B; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox { background: #0B1220; border: 1px solid #334155; border-radius: 6px; padding: 4px 8px; selection-background-color: #3B82F6; }
QTextEdit#logEdit { font-family: monospace; font-size: 9pt; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid #3B82F6; }
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QCheckBox:disabled { color: #64748B; background: #111827; }
QPushButton { background: #1E293B; border: 1px solid #334155; border-radius: 6px; padding: 7px 14px; }
QPushButton:hover { background: #334155; border-color: #475569; }
QPushButton:disabled { color: #64748B; background: #111827; border-color: #1E293B; }
QPushButton#runButton { background: #3B82F6; border: 0; border-radius: 8px; min-height: 44px; font-weight: 700; }
QPushButton#runButton:hover { background: #60A5FA; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; }
QComboBox QAbstractItemView { background: #111A2E; border: 1px solid #1E293B; selection-background-color: #3B82F6; }
QProgressBar { background: #111A2E; border: 0; border-radius: 2px; max-height: 5px; text-align: center; }
QProgressBar::chunk { background: #3B82F6; border-radius: 2px; }
QScrollBar:vertical { background: #0B1220; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #334155; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSplitter::handle { background: #1E293B; height: 5px; }
